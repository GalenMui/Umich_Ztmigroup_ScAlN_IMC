# Smart ZYNQ SL V1.2/V1.3/V1.3B J5: Bank 35, fixed 3.3 V, LVCMOS33.
# Logical J5[0:33] correspond to physical connector pins 7:40.
# Enable only the lines for implemented ports. No J5 pins are assigned by
# this scaffold until a matching top-level port exists.
# set_property -dict {PACKAGE_PIN H19 IOSTANDARD LVCMOS33} [get_ports {j5[0]}]
